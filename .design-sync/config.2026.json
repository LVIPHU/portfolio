{
  "projectId": "dc0c0939-0f5c-4409-87d4-2a38ca0d3b5e",
  "shape": "package",
  "pkg": "@portfolio/ui",
  "globalName": "Web2026UI",
  "entry": "packages/ui/src/index.ts",
  "srcDir": "src/components",
  "tsconfig": "../../.design-sync/tsconfig.dsync.2026.json",
  "cssEntry": ".ds-css/css2026.css",
  "buildCmd": "node .design-sync/refresh-css-2026.mjs",
  "provider": {
    "component": "DsTheme2026"
  },
  "componentSrcMap": {
    "Avatar": "src/components/avatar.tsx",
    "Badge": "src/components/badge.tsx",
    "Button": "src/components/button.tsx",
    "Card": "src/components/card.tsx",
    "Dialog": "src/components/dialog.tsx",
    "Drawer": "src/components/drawer.tsx",
    "DropdownMenu": "src/components/dropdown-menu.tsx",
    "Form": "src/components/form.tsx",
    "HoverCard": "src/components/hover-card.tsx",
    "Input": "src/components/input.tsx",
    "Label": "src/components/label.tsx",
    "Pagination": "src/components/pagination.tsx",
    "Popover": "src/components/popover.tsx",
    "ScrollArea": "src/components/scroll-area.tsx",
    "Select": "src/components/select.tsx",
    "Separator": "src/components/separator.tsx",
    "Tabs": "src/components/tabs.tsx",
    "Textarea": "src/components/textarea.tsx",
    "ToggleGroup": "src/components/toggle-group.tsx",
    "Toggle": "src/components/toggle.tsx",
    "Tooltip": "src/components/tooltip.tsx",
    "FelixHeroMark": "../../apps/2026/src/components/brand/felix-mark.tsx",
    "ListItem": "../../apps/2026/src/components/effects/list-item.tsx",
    "Marquee": "../../apps/2026/src/components/effects/marquee.tsx",
    "AppearTitle": "../../apps/2026/src/components/effects/appear-title.tsx",
    "ShowcaseCard": "../../apps/2026/src/components/effects/card.tsx"
  },
  "overrides": {
    "Dialog": {
      "cardMode": "single",
      "primaryStory": "DeletePostConfirm"
    },
    "Drawer": {
      "cardMode": "single",
      "primaryStory": "ShareArticleDrawer"
    },
    "HoverCard": {
      "cardMode": "single",
      "primaryStory": "AuthorProfileCard"
    },
    "Popover": {
      "cardMode": "single",
      "primaryStory": "SharePostPopover"
    },
    "Select": {
      "cardMode": "single",
      "primaryStory": "OpenLanguagePicker"
    },
    "Tooltip": {
      "cardMode": "single",
      "primaryStory": "SaveArticleTooltip"
    },
    "DropdownMenu": {
      "cardMode": "single",
      "primaryStory": "PostActionsMenu"
    },
    "ShowcaseCard": {
      "cardMode": "column"
    }
  },
  "extraEntries": ["@portfolio/icons", "../../.design-sync/shims/app-2026.tsx"],
  "readmeHeader": "../../.design-sync/conventions.md",
  "guidelinesGlob": ["../../apps/2026/docs/*.md"]
}
