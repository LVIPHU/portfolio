# -----------------------------------------------------------------------------
# Site URL (Open Graph / canonical)
# -----------------------------------------------------------------------------

# Origin https, không slash cuối. Crawler chỉ nhận og:url / og:image tuyệt đối.
# Production: set NEXT_PUBLIC_SITE_URL = domain đang share (đổi nếu không còn web-2026.vercel.app).
# Preview: để trống — seo.ts fallback NEXT_PUBLIC_VERCEL_URL (hostname preview), không hardcode URL production.
NEXT_PUBLIC_SITE_URL=https://web-2026.vercel.app
# Alias cùng origin — seo.ts đọc SITE_URL rồi mới APP_URL, để hai app khỏi lệch tên biến.
NEXT_PUBLIC_APP_URL=https://web-2026.vercel.app

# -----------------------------------------------------------------------------
# Database (optional — blog stats soft-fail to zeros when unset/invalid)
# -----------------------------------------------------------------------------

DATABASE_URL=

# -----------------------------------------------------------------------------
# Analytics (optional — omit to skip scripts)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_UMAMI_WEBSITE_ID=
